#. Description of the plugin
#: drusoft-shipping-for-econt.php
msgid "A clean, conflict-free Econt integration for Bulgaria."
msgstr "Чиста, безконфликтна Еконт интеграция за България."

#. Author of the plugin
#: drusoft-shipping-for-econt.php
msgid "DRUSOFT LTD"
msgstr "ДРУСОФТ ЕООД"

#. Author URI of the plugin
